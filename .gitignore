# Environment variables & secrets
.env
.env.*
*.env
*.local

# API keys, tokens & credentials
*credential*
*secret*
*token*
*.pem
*.key
*.cert
*.crt
id_rsa*

# Configuration files with possible private data
config.json
credentials.json
secrets.json

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Editor & IDE Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs & Temporary files
*.log
*.tmp
*.bak
*.swp
*.swo

